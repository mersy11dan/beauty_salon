# Copy to .env.local for development. In production, set the same names in your host's environment settings.

# Postgres connection string.
# Local:  postgres://salon:salon@localhost:5432/salon  (see docker-compose.yml, or a local Postgres install)
# Neon:   use the "Pooled connection" string from the Neon dashboard (host contains "-pooler").
DATABASE_URL=postgres://salon:salon@localhost:5432/salon

# Max open connections per server instance. Keep it low (3-5) on serverless hosts.
DATABASE_POOL_MAX=5

# Photo storage. Leave empty to save photos on this machine's disk under UPLOADS_DIR (fine for development).
# Production: Cloudinary free plan. Dashboard > Settings > API Keys > "API environment variable".
# Looks like cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Folder the photos go into inside your Cloudinary media library.
CLOUDINARY_FOLDER=salon
UPLOADS_DIR=.data/uploads

# The first admin login, created or updated by `npm run db:seed` (on Vercel, created by the first production deploy).
# Use a password of at least 8 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# true only for the public demo: shows demo logins on the sign-in pages and allows "Reset to demo data".
# Must be false (or unset) for the real salon.
DEMO_MODE=true
